#
# Frontend Environment Configuration
# Copy this file to `.env` and update the values for your environment.
#

# Absolute base URL of the backend API (include /api suffix) or use relative /api for same-origin proxy
VITE_API_BASE_URL=/api

# Stripe publishable key for client-side payments
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_key_here

# Supabase (optional, if using Supabase features)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Production (api.simplyai.it) ---
# VITE_API_BASE_URL=https://api.simplyai.it/api
# VITE_STRIPE_PUBLISHABLE_KEY=pk_live_your_key_here
